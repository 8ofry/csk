# ─── Database ───────────────────────────────────────────
# Local dev: docker run --name csk-pg -e POSTGRES_PASSWORD=csk -e POSTGRES_DB=csk -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:csk@localhost:5432/csk?schema=public"

# ─── Auth.js (NextAuth v5) ──────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Email (Resend / SES / Mailgun) ─────────────────────
EMAIL_PROVIDER="resend"   # resend | ses | mailgun | smtp
EMAIL_FROM="CSK Academy <noreply@cskacademy.example>"
RESEND_API_KEY=""

# ─── WhatsApp (UltraMsg in v1, official API in v2) ──────
WHATSAPP_PROVIDER="ultramsg"   # ultramsg | 360dialog | twilio | meta
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# ─── Storage (S3-compatible: R2 or DO Spaces) ───────────
STORAGE_PROVIDER="r2"          # r2 | s3 | spaces | local
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="csk-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="CSK Academy"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NEXT_PUBLIC_SUPPORTED_LOCALES="ar,en"

# ─── Payments (v2) ──────────────────────────────────────
PAYMENT_PROVIDER="auto"   # auto | paymob | vodafone-cash | fawry | console
# Paymob (Egypt). Set all four to enable real online payments.
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""
# Vodafone Cash direct integration (alternative to Paymob's VC routing).
VODAFONE_CASH_MERCHANT_ID=""
VODAFONE_CASH_TERMINAL_ID=""
VODAFONE_CASH_SECRET=""
VODAFONE_CASH_BASE_URL=""
# Fawry (cash at kiosk + reference number).
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""
FAWRY_BASE_URL=""

# ─── Observability (Sentry) ─────────────────────────────
# Leave blank in dev — logger falls back to console JSON lines.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ─── Background jobs / cron ─────────────────────────────
# Bearer token for the manual /api/v1/admin/jobs/medical-alerts trigger.
CRON_SECRET=""

# ─── Feature flags (v2 features OFF in v1) ──────────────
FEATURE_ONLINE_PAYMENTS="false"
FEATURE_ECOMMERCE_CHECKOUT="false"
FEATURE_AUTO_CERTIFICATES="false"
FEATURE_NATIVE_MOBILE_API="false"
